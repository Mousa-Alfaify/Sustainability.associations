# انسخ هذا الملف إلى .env.local (للتطوير المحلي) واملأ القيمتين من
# لوحة تحكم Supabase: Project Settings → API
#
# بدون هاتين القيمتين يعمل التطبيق تلقائيًا في «وضع العرض التجريبي
# المحلي» (بيانات محفوظة في متصفحك فقط، بلا حسابات حقيقية) — راجع
# README.md لخطوات إنشاء مشروع Supabase مجاني وتفعيل الوضع الكامل.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY هو مفتاح عام (anon/public) مخصص
# للاستخدام من المتصفح ويُحمى بسياسات RLS في supabase/schema.sql —
# ليس سرًّا، لكن لا تضع هنا service_role key أبدًا.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
